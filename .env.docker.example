APP_NAME=HangVeApiAdmin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hangve_admin
DB_USERNAME=hangve
DB_PASSWORD=hangve_local_password
DB_ROOT_PASSWORD=hangve_local_password
DB_FORWARD_PORT=3307

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Set QUEUE_CONNECTION=redis before enabling the queue profile.
DOCKER_QUEUES=default,sent-noti-admin

MAIL_MAILER=log
MAIL_FROM_ADDRESS=local@example.test
MAIL_FROM_NAME="${APP_NAME}"

TELESCOPE_ENABLED=false
SYNC_MAX_PING=false
